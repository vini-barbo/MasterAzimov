# Variáveis de ambiente para PostgreSQL
# .env.db

# === CONFIGURAÇÕES BÁSICAS DO POSTGRESQL ===
POSTGRES_DB=igem_stock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_password_change_me

# === CONFIGURAÇÕES DA APLICAÇÃO ===
# Usuário específico para a aplicação
POSTGRES_APP_USER=igem_app
POSTGRES_APP_PASSWORD=app_password_change_me

# Usuário apenas leitura
POSTGRES_READONLY_USER=igem_readonly
POSTGRES_READONLY_PASSWORD=readonly_password_change_me

# === CONFIGURAÇÕES DE CONEXÃO ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexão completa para a aplicação
DATABASE_URL=postgresql://igem_app:app_password_change_me@localhost:5432/igem_stock

# URL de conexão para operações administrativas
DATABASE_ADMIN_URL=postgresql://postgres:postgres_super_password_change_me@localhost:5432/igem_stock

# URL de conexão apenas leitura
DATABASE_READONLY_URL=postgresql://igem_readonly:readonly_password_change_me@localhost:5432/igem_stock

# === CONFIGURAÇÕES DE PERFORMANCE ===
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=100

# === CONFIGURAÇÕES DE BACKUP ===
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_SCHEDULE="0 2 * * *"  # Todo dia às 2h da manhã

# === CONFIGURAÇÕES DE LOGGING ===
POSTGRES_LOG_STATEMENT=mod
POSTGRES_LOG_MIN_DURATION=1000
POSTGRES_LOG_LEVEL=info

# === CONFIGURAÇÕES DE TIMEZONE ===
POSTGRES_TIMEZONE=America/Sao_Paulo
POSTGRES_LOCALE=pt_BR.utf8

# === CONFIGURAÇÕES DE SSL (para produção) ===
POSTGRES_SSL_MODE=disable  # disable, require, verify-ca, verify-full
POSTGRES_SSL_CERT_PATH=/etc/ssl/certs/postgresql.crt
POSTGRES_SSL_KEY_PATH=/etc/ssl/private/postgresql.key

# === CONFIGURAÇÕES DE MONITORAMENTO ===
POSTGRES_STATS_ENABLED=true
POSTGRES_TRACK_ACTIVITIES=true
POSTGRES_TRACK_COUNTS=true

# === CONFIGURAÇÕES ESPECÍFICAS PARA DOCKER ===
PGDATA=/var/lib/postgresql/data
POSTGRES_INITDB_ARGS="--encoding=UTF-8 --locale=pt_BR.utf8"
POSTGRES_INITDB_WALDIR=/var/lib/postgresql/data/pg_wal
