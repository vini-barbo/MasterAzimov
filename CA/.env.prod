# Production Environment Variables for Redis Cache
REDIS_PASSWORD=your_super_secure_password_here
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Container Resources
REDIS_MEMORY_LIMIT=8G
REDIS_CPU_LIMIT=4.0
REDIS_MEMORY_RESERVATION=2G
REDIS_CPU_RESERVATION=1.0

# Paths (absolute paths recommended for production)
REDIS_DATA_PATH=/opt/redis/data
REDIS_LOGS_PATH=/opt/redis/logs
REDIS_BACKUP_PATH=/opt/redis/backups

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# Ports
REDIS_PORT=6379
REDIS_EXPORTER_PORT=9121
