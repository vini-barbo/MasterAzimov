# Testing Environment Variables for Redis Cache
# No password for testing
REDIS_PASSWORD=

REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Container Resources
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_LIMIT=0.5

# Backup Configuration (shorter retention for testing)
BACKUP_RETENTION_DAYS=1

# Ports (different from production)
REDIS_PORT=6380
