# Master Azimov - Environment Variables
# Copie para .env e configure as variáveis necessárias

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/igem_stock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=igem_stock
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_PORT=5432

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TTL=3600
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
JWT_SECRET=your_super_secure_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=24h

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=production
PORT=3000
GLOBAL_PREFIX=api
BACKEND_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# ==============================================================================
# NGINX CONFIGURATION
# ==============================================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================================================
# MONITORING - PROMETHEUS
# ==============================================================================
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080

# ==============================================================================
# MONITORING - GRAFANA
# ==============================================================================
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_here
GRAFANA_ROOT_URL=http://localhost:3030
GRAFANA_SECRET_KEY=secure_grafana_secret_key_here

# ==============================================================================
# MONITORING - ELK STACK
# ==============================================================================
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
KIBANA_PORT=5601
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000
LOGSTASH_API_PORT=9600

# ==============================================================================
# MONITORING - ALERTING
# ==============================================================================
ALERTMANAGER_PORT=9093

# ==============================================================================
# MONITORING - TRACING
# ==============================================================================
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_GRPC_PORT=14250
JAEGER_STORAGE_TYPE=memory

# ==============================================================================
# ALERTING CONFIGURATION
# ==============================================================================
# Email para alertas
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@masterazimov.com
SMTP_AUTH_USERNAME=alerts@masterazimov.com
SMTP_AUTH_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=admin@masterazimov.com

# Slack para alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# ==============================================================================
# SECURITY (PRODUCTION ONLY)
# ==============================================================================
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ==============================================================================
# RESOURCE LIMITS (PRODUCTION)
# ==============================================================================
# Elasticsearch
ES_HEAP_SIZE=2g

# Logstash
LS_HEAP_SIZE=1g

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================
BACKUP_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=7
