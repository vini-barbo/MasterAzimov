# Master Azimov - Monitoring Environment Variables
# Copie este arquivo para .env e configure as variáveis

# ==============================================================================
# CONFIGURAÇÕES GERAIS
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME=master-azimov

# ==============================================================================
# GRAFANA
# ==============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_USERS_ALLOW_SIGN_UP=false
GF_SECURITY_ALLOW_EMBEDDING=true

# ==============================================================================
# ELASTICSEARCH
# ==============================================================================
ES_JAVA_OPTS=-Xms2g -Xmx2g
ELASTIC_PASSWORD=elastic123
ELASTIC_USERNAME=elastic

# ==============================================================================
# LOGSTASH
# ==============================================================================
LS_JAVA_OPTS=-Xmx1g -Xms1g

# ==============================================================================
# ALERTMANAGER - EMAIL NOTIFICATIONS
# ==============================================================================
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@masterazimov.com
SMTP_AUTH_USERNAME=alerts@masterazimov.com
SMTP_AUTH_PASSWORD=your-app-password
ALERT_EMAIL_TO=admin@masterazimov.com

# ==============================================================================
# ALERTMANAGER - SLACK NOTIFICATIONS
# ==============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# ==============================================================================
# ALERTMANAGER - WEBHOOK
# ==============================================================================
WEBHOOK_URL=http://localhost:5001/webhook
WEBHOOK_USERNAME=azimov
WEBHOOK_PASSWORD=webhook-secret

# ==============================================================================
# RETENTION POLICIES
# ==============================================================================
PROMETHEUS_RETENTION=200h
ELASTICSEARCH_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=90

# ==============================================================================
# RESOURCE LIMITS
# ==============================================================================
# Elasticsearch
ES_MEM_LIMIT=4g
ES_HEAP_SIZE=2g

# Prometheus
PROMETHEUS_MEM_LIMIT=2g

# Grafana
GRAFANA_MEM_LIMIT=512m

# Logstash
LOGSTASH_MEM_LIMIT=2g

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================
# Portas principais (altere se houver conflito)
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090
KIBANA_PORT=5601
ELASTICSEARCH_PORT=9200
ALERTMANAGER_PORT=9093
JAEGER_PORT=16686
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Todo dia às 2h da manhã
BACKUP_LOCATION=/opt/backups/azimov-monitoring

# ==============================================================================
# MONITORING THRESHOLDS
# ==============================================================================
# Sistema
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90

# Aplicação
RESPONSE_TIME_THRESHOLD=1000  # ms
ERROR_RATE_THRESHOLD=5        # %

# ==============================================================================
# EXTERNAL TARGETS
# ==============================================================================
# Adicione aqui targets externos para monitoramento
EXTERNAL_TARGET_1=http://api.example.com:8080/metrics
EXTERNAL_TARGET_2=http://app.example.com:9090/metrics

# ==============================================================================
# SECURITY
# ==============================================================================
# SSL/TLS (para produção)
ENABLE_SSL=false
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem

# Autenticação
ENABLE_AUTH=true
AUTH_TYPE=basic  # basic, oauth, ldap

# LDAP (se AUTH_TYPE=ldap)
LDAP_URL=ldap://ldap.company.com:389
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=ldap-password
LDAP_SEARCH_BASE=ou=users,dc=company,dc=com

# OAuth (se AUTH_TYPE=oauth)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_AUTH_URL=https://auth.company.com/oauth/authorize
OAUTH_TOKEN_URL=https://auth.company.com/oauth/token

# ==============================================================================
# CUSTOM DASHBOARDS
# ==============================================================================
# URLs para dashboards customizados
CUSTOM_DASHBOARD_1=https://grafana.com/api/dashboards/1860/revisions/27/download
CUSTOM_DASHBOARD_2=https://grafana.com/api/dashboards/893/revisions/1/download

# ==============================================================================
# INTEGRATIONS
# ==============================================================================
# Integração com outros sistemas
ENABLE_PAGERDUTY=false
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

ENABLE_OPSGENIE=false
OPSGENIE_API_KEY=your-opsgenie-key

ENABLE_TEAMS=false
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# ==============================================================================
# DEBUG
# ==============================================================================
DEBUG_MODE=false
LOG_LEVEL=info  # debug, info, warn, error
