# Arquivo de exemplo para variáveis de ambiente de produção
# Copie este arquivo para .env.prod e configure com seus valores reais

# Banco de dados
POSTGRES_DB=igem_stock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
DB_PORT=5432

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Backend
JWT_SECRET=your_very_strong_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=24h
BACKEND_PORT=3000
LOG_LEVEL=info

# CORS e segurança
CORS_ORIGIN=https://yourdomain.com
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Nginx (se usar)
NGINX_PORT=80
NGINX_SSL_PORT=443
